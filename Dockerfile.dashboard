# Dockerfile.dashboard
#
# Multi-stage build for the Credit Risk XAI Dashboard.
#
# Stage 1 (builder): npm install + vite build.
# Stage 2 (runtime): nginx serves the static bundle.
#
# Usage:
#   docker build -f Dockerfile.dashboard -t credit-risk-dashboard ./dashboard
#   docker run -p 5173:80 credit-risk-dashboard

# ---------------------------------------------------------------------------
# Stage 1: Build
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm install --frozen-lockfile 2>/dev/null || npm install
COPY dashboard/ ./
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: Serve
# ---------------------------------------------------------------------------
FROM nginx:alpine AS runtime

COPY --from=builder /app/dist /usr/share/nginx/html

# SPA fallback: serve index.html for all routes
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
  location /predict_risk/ {\n\
    proxy_pass http://api:8000;\n\
  }\n\
  location /evaluation/ {\n\
    proxy_pass http://api:8000;\n\
  }\n\
  location /health {\n\
    proxy_pass http://api:8000;\n\
  }\n\
  location /alive {\n\
    proxy_pass http://api:8000;\n\
  }\n\
  location /metrics {\n\
    proxy_pass http://api:8000;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
