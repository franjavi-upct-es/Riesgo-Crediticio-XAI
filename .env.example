# .env.example
#
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults — the app runs without a .env file.

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_RELOAD=true
API_LOG_LEVEL=info
API_LOG_FORMAT=console          # "console" for dev, "json" for production

# --- Authentication ---
# API_KEY=                  # Uncomment and set to enable API key auth
# API_CORS_ORIGINS=["http://localhost:8501","http://localhost:5173"]

# --- Rate limiting ---
API_RATE_LIMIT=60/minute
API_RATE_LIMIT_ENABLED=true

# --- Model artifacts ---
MODEL_DIR=models
MODEL_FILENAME=xgb_model.pkl
MODEL_FEATURE_NAMES_FILENAME=feature_names.pkl

# --- Data ---
DATA_DIR=data
DATA_SYNTHETIC_TEST_FILENAME=synthetic_test_set.csv
DATA_UCI_DATASET_ID=144

# --- Training (overridable, but prefer configs/training.yml) ---
TRAIN_TEST_SIZE=0.2
TRAIN_RANDOM_STATE=42
TRAIN_XGB_N_ESTIMATORS=100
TRAIN_XGB_LEARNING_RATE=0.1

# --- SHAP ---
SHAP_SIGNIFICANCE_THRESHOLD=0.001

# --- MLflow ---
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=credit-risk-xai
MLFLOW_LOG_MODELS=true

# --- OpenTelemetry ---
OTEL_ENABLED=false              # Set true + provide collector endpoint
OTEL_SERVICE_NAME=credit-risk-api
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# --- Drift detection ---
DRIFT_REFERENCE_WINDOW_SIZE=200
DRIFT_DETECTION_THRESHOLD=0.05
DRIFT_BUFFER_SIZE=50
