# credit-risk-xai/.gitignore

# ================================
# Python
# ================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ================================
# Virtual environments
# ================================
.venv/
venv/
ENV/
env/

# ================================
# Environment and secrets
# ================================
.env
*.envrc

# ================================
# Generated artifacts (reproducible via `make train`)
# ================================
models/
data/
artifacts/
mlruns/
!src/data

# ================================
# Test and coverage output
# ================================
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ================================
# Type checking and linting
# ================================
.mypy_cache/
.ruff_cache/

# ================================
# IDE / Editor
# ================================
.idea/
.vscode/
*.swp
*.swo
*.bak

# ================================
# OS
# ================================
.DS_Store
Thumbs.db

# ================================
# Docker
# ================================
docker-compose.override.yml

# ================================
# Node (dashboard)
# ================================
node_modules/
dashboard/dist/
dashboard/.cache/
